# Copy to .env.local (git-ignored) and restart `npx expo start`. Public values only; secrets live in the Convex deployment env.
# fixture: in-memory SAMPLE_* data, labeled "Sample data" in the UI. live: the shared Convex dev deployment.
EXPO_PUBLIC_DATA_MODE=fixture
EXPO_PUBLIC_CONVEX_URL=https://little-shrimp-172.convex.cloud
# Closet code: the only credential for a closet. Phones with the same code share one closet.
# The real code is long and random and is shared out of band. Put it in .env.local only; never commit it.
EXPO_PUBLIC_CLOSET_CODE=<shared-out-of-band>
